{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "网络测试工具箱",
  "version": "9.0.0",
  "identifier": "com.rebuild.network-toolkit",
  "build": {
    "frontendDist": "../analysis/tauri-assets"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "网络测试工具箱 V9.0  作者：运维杂谈",
        "width": 1280,
        "height": 820,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../analysis/original-extracted/$LOCALAPPDATA/yunweizatan/network-toolkit-9.0.0/ffmpeg.exe": "ffmpeg.exe",
      "../analysis/original-extracted/$LOCALAPPDATA/yunweizatan/network-toolkit-9.0.0/hwmonitor.exe": "hwmonitor.exe",
      "../analysis/original-extracted/$LOCALAPPDATA/yunweizatan/network-toolkit-9.0.0/FFMPEG-NOTICE.txt": "FFMPEG-NOTICE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
